# CodingStudio browser mode: the gateway + the per-user workers in one image
# (PLAN_online_only §8).  Build from the REPO ROOT (Server/docker-compose.yml
# does this):
#   docker build -f Server/Dockerfile.web -t studio-web:local .
# BuildKit reads Server/Dockerfile.web.dockerignore, an allow-list that keeps the
# build context small (the repo holds large data folders and the desktop dist).
#
# One container, one supervisor: uvicorn (the gateway) starts a headless
# CodingStudio worker per (user, project) as a forkserver child, all in this
# container's cgroup, so the compose memory limit bounds the whole browser side.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MALLOC_ARENA_MAX=2 \
    STUDIO_WEB_DATA=/srv/studio/web \
    STUDIO_WEB_SERVER=http://studio:8770 \
    STUDIO_WEB_LOCAL_BLOBS=/blobs

# non-root runtime user (same fixed UID as the sync server, so install.sh can set
# host-side ownership of /srv/studio/web once)
RUN groupadd --system --gid 10001 studio \
 && useradd --system --uid 10001 --gid studio --home-dir /srv/studio/web \
            --no-create-home --shell /usr/sbin/nologin studio

WORKDIR /app

COPY Server/requirements-web.txt /tmp/requirements-web.txt
RUN pip install --no-cache-dir -r /tmp/requirements-web.txt \
 && rm -f /tmp/requirements-web.txt

# Application code, owned by root and read-only for the runtime user.  The repo
# layout is kept, so `studio_web.repo_scripts()` finds
# /app/Scripts/coding_web/browser_worker.py and the worker's import path is
# /app/Scripts + /app/Scripts/coding_web (exactly as in a checkout).
# `Scripts/coding_web/Schemes/` travels with the app: the scheme library is
# vocabulary, never project data, and it is read-only here (scheme editing is
# desktop-only, PLAN_online_only §7).
COPY Scripts/ /app/Scripts/
COPY Server/studio_web/ /app/Server/studio_web/

WORKDIR /app/Server
USER studio
EXPOSE 8780

# the gateway answers /app/health even while no worker runs; a failing worker is
# visible there (detail) and in the container log, not by making the container
# unhealthy (the sync server must stay reachable either way)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8780/app/health', timeout=4).status == 200 else 1)"

# one uvicorn process; the workers are its children (forkserver), so the cgroup
# limit covers the gateway, the forkserver and every worker
CMD ["python", "-m", "studio_web", "serve", "--host", "0.0.0.0", "--port", "8780"]
