# Allow-list build context for Server/Dockerfile (build context = repo root).
# BuildKit reads this file because it sits next to Server/Dockerfile.
# Docker applies the LAST matching rule, so the re-excludes below win.

*

!Scripts
!Scripts/**
!Server
!Server/**

# re-exclude what must not reach the image
Server/tests
Server/studio_web/tests
Server/deploy
Server/*.md
Scripts/tests
Scripts/coding_web/dist
Scripts/coding_web/tests_static
Scripts/coding_web/online/tests
Scripts/online_shared/tests
**/__pycache__
**/*.pyc
**/.pytest_cache
