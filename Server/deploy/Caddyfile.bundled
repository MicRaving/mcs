# Bundled reverse proxy (compose profile "caddy"). Only for installs without an
# existing proxy. The production LAN setup uses the proxy on CT 110 instead
# (see caddy-snippet.txt / caddy-browser-mode.txt).
#
# STUDIO_DOMAIN: public name for a Let's Encrypt certificate. The default
# "localhost" makes Caddy use its internal CA.
#
# One origin, two ports of the SAME container (PLAN_online_only §8): /app/... is
# the browser gateway (login, project picker, /app/p/<pid>/... -> that user's
# worker), everything else is the sync server, unchanged for desktop clients.
# With STUDIO_BROWSER_MODE=0 the same port answers /app/ with the "switched off"
# page, so this proxy configuration never changes.
{$STUDIO_DOMAIN:localhost} {
	encode zstd gzip

	# uploads up to 200 MB (plus margin); the app enforces its own limits too
	request_body {
		max_size 250MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# the browser app
	@browser path /app /app/*
	handle @browser {
		reverse_proxy studio:8780
	}

	# everything else: the sync server
	handle {
		reverse_proxy studio:8770
	}

	# a bare "/" is not the app any more: send the browser to the gateway
	redir / /app/ 302
}
